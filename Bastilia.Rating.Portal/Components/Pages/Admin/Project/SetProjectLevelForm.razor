@using Microsoft.AspNetCore.Components.Authorization
@inject IProjectService projectService
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<Card>
    <Header>Уровень проекта</Header>
    <Body>
        <EditForm FormName="SetProjectLevelForm" Model="Model" OnValidSubmit="Save">
            <div>
                <label>
                    Уровень:
                    <InputSelect @bind-Value="Model!.ProjectLevel" class="form-select">
                        <option value="">— выберите уровень —</option>
                        <option value="@ProjectLevel.XS">XS</option>
                        <option value="@ProjectLevel.S">S</option>
                        <option value="@ProjectLevel.M">M</option>
                        <option value="@ProjectLevel.L">L</option>
                    </InputSelect>
                </label>
            </div>
            @if (Model!.ProjectLevel is not null)
            {
                <div class="alert alert-info">@Model.ProjectLevel.Value.GetSizeDescription()</div>
            }
            @if (error is not null)
            {
                <Alert>@error</Alert>
            }
            <div>
                <input type="submit" value="Сохранить уровень" class="btn btn-danger" />
            </div>
        </EditForm>
    </Body>
</Card>

@code {
    [Parameter, EditorRequired]
    public int ProjectId { get; set; }

    [Parameter]
    public ProjectLevel? CurrentLevel { get; set; }

    [Parameter]
    public EventCallback OnCompleted { get; set; }

    [SupplyParameterFromForm]
    private SetLevelViewModel? Model { get; set; }

    private string? error;

    protected override void OnInitialized()
    {
        Model ??= new SetLevelViewModel { ProjectLevel = CurrentLevel };
        base.OnInitialized();
    }

    private async Task Save()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsInRole(BastiliaRoles.President))
        {
            error = "Уровень проекта может изменить только председатель";
            return;
        }
        if (Model!.ProjectLevel is null)
        {
            error = "Выберите уровень проекта";
            return;
        }
        error = null;

        try
        {
            await projectService.SetProjectLevel(ProjectId, Model.ProjectLevel.Value);
        }
        catch (ArgumentException exception)
        {
            error = exception.Message;
            return;
        }

        await OnCompleted.InvokeAsync();
        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
    }

    private class SetLevelViewModel
    {
        public ProjectLevel? ProjectLevel { get; set; }
    }
}
