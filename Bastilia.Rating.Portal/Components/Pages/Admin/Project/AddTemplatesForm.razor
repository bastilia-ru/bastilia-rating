@inject IProjectService projectService
@inject NavigationManager navigationManager

<Card>
    <Header>Добавить шаблоны ачивок</Header>
    <Body>
        <EditForm FormName="AddTemplatesForm" Model="Model" OnValidSubmit="Complete">
            <AchievementTemplateNamesInput ProjectLevel="ProjectLevel" Templates="Model!.Templates" LevelSelectable="false" />
            @if (error is not null)
            {
                <Alert>@error</Alert>
            }
            <div>
                <input type="submit" value="Добавить шаблоны" class="btn btn-danger" />
            </div>
        </EditForm>
    </Body>
</Card>

@code {
    [Parameter, EditorRequired]
    public int ProjectId { get; set; }

    [Parameter, EditorRequired]
    public ProjectLevel ProjectLevel { get; set; }

    [Parameter]
    public EventCallback OnCompleted { get; set; }

    [SupplyParameterFromForm]
    private AddTemplatesViewModel? Model { get; set; }

    private string? error;

    protected override void OnInitialized()
    {
        Model ??= new AddTemplatesViewModel { Templates = AchievementTemplateInputHelper.CreateDefaults(ProjectLevel) };
        base.OnInitialized();
    }

    private async Task Complete()
    {
        if (Model!.Templates.Any(t => string.IsNullOrWhiteSpace(t.Name)))
        {
            error = "Заполните название для каждой ачивки уровня";
            return;
        }
        error = null;

        await projectService.AddAchievementTemplates(ProjectId, Model.Templates);
        await OnCompleted.InvokeAsync();
        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
    }

    private class AddTemplatesViewModel
    {
        public AchievementTemplateInput[] Templates { get; set; } = [];
    }
}
