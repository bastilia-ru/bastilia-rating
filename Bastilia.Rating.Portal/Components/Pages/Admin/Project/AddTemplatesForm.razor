@inject IProjectService projectService
@inject NavigationManager navigationManager

<Card>
    <Header>Добавить шаблоны ачивок</Header>
    <Body>
        <EditForm FormName="AddTemplatesForm" Model="Model" OnValidSubmit="Complete">
            <AchievementTemplateNamesInput @bind-ProjectLevel="Model!.ProjectLevel" TemplateNames="Model!.TemplateNames" />
            @if (error is not null)
            {
                <Alert>@error</Alert>
            }
            <div>
                <input type="submit" value="Добавить шаблоны" class="btn btn-danger" />
            </div>
        </EditForm>
    </Body>
</Card>

@code {
    [Parameter, EditorRequired]
    public int ProjectId { get; set; }

    [Parameter]
    public EventCallback OnCompleted { get; set; }

    [SupplyParameterFromForm]
    private AddTemplatesViewModel? Model { get; set; }

    private string? error;

    protected override void OnInitialized()
    {
        Model ??= new AddTemplatesViewModel();
        base.OnInitialized();
    }

    private async Task Complete()
    {
        var ratingValues = Model!.ProjectLevel.GetAchievementRatingValues();
        var names = Model.TemplateNames.Take(ratingValues.Count).ToList();
        if (names.Any(string.IsNullOrWhiteSpace))
        {
            error = "Заполните название для каждой ачивки уровня";
            return;
        }
        error = null;

        await projectService.AddAchievementTemplates(ProjectId, Model.ProjectLevel, names);
        await OnCompleted.InvokeAsync();
        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
    }

    private class AddTemplatesViewModel
    {
        public ProjectLevel ProjectLevel { get; set; } = ProjectLevel.XS;
        public List<string> TemplateNames { get; set; } = ["", "", ""];
    }
}
