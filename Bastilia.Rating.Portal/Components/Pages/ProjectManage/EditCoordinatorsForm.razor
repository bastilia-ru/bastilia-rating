@using JoinRpg.Common.PrimitiveTypes
@inject IProjectService projectService
@inject UserLoaderHelper userLoaderHelper
@inject NavigationManager navigationManager

<JoinCollapsePanel>
    <Header>Координаторы и новости</Header>
    <ChildContent>
        <EditForm FormName="EditCoordinatorsForm" Model="Model" OnValidSubmit="Submit">
            <div>
                <MultiUserInput Label="Координаторы проекта:" @bind-Value="Model!.Coordinators" />
            </div>
            @if (IsActive)
            {
                <div>
                    <label>
                        Как часто ждём новостей:
                        <InputSelect @bind-Value="Model!.NewsCadence" class="form-select">
                            @foreach (var cadence in Enum.GetValues<NewsCadence>())
                            {
                                <option value="@cadence">@cadence.GetNewsCadenceDescription()</option>
                            }
                        </InputSelect>
                    </label>
                </div>
            }
            <div>
                <JoinButton Submit Preset="ButtonPreset.Save" />
            </div>
        </EditForm>
    </ChildContent>
</JoinCollapsePanel>

@code {
    [Parameter, EditorRequired]
    public BastiliaProjectId ProjectId { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyCollection<IUserLink> Coordinators { get; set; } = [];

    [Parameter, EditorRequired]
    public NewsCadence CurrentCadence { get; set; }

    [Parameter, EditorRequired]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback OnCompleted { get; set; }

    [SupplyParameterFromForm]
    private EditCoordinatorsViewModel? Model { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new EditCoordinatorsViewModel
        {
            Coordinators = [.. Coordinators.Select(c => c.Slug ?? c.JoinrpgUserId.Value.ToString())],
            NewsCadence = CurrentCadence,
        };
        base.OnInitialized();
    }

    private async Task Submit()
    {
        var users = await userLoaderHelper.LoadUsersWithCheck(Model!.Coordinators);
        var coordinators = users.Select(u => u.JoinrpgUserId).ToList();

        await projectService.UpdateCoordinators(ProjectId, coordinators);
        if (IsActive)
        {
            await projectService.SetNewsCadence(ProjectId, Model.NewsCadence);
        }
        await OnCompleted.InvokeAsync();
        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
    }

    private class EditCoordinatorsViewModel
    {
        public string[] Coordinators { get; set; } = [];
        public NewsCadence NewsCadence { get; set; }
    }
}
