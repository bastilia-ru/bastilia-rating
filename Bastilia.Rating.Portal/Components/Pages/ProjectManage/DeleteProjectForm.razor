@using Microsoft.AspNetCore.Components.Authorization
@inject IProjectService projectService
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<JoinCollapsePanel>
    <Header>Удалить проект</Header>
    <ChildContent>
        <EditForm FormName="DeleteProjectForm" Model="Model" OnValidSubmit="Delete">
            @if (error is not null)
            {
                <Alert>@error</Alert>
            }
            <div>
                <JoinButton Submit Label="Удалить проект" Style="VariationStyleEnum.Danger" />
            </div>
        </EditForm>
    </ChildContent>
</JoinCollapsePanel>

@code {
    [Parameter, EditorRequired]
    public int ProjectId { get; set; }

    [SupplyParameterFromForm]
    private DeleteViewModel? Model { get; set; }

    private string? error;

    protected override void OnInitialized()
    {
        Model ??= new DeleteViewModel();
        base.OnInitialized();
    }

    private async Task Delete()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsInRole(BastiliaRoles.President))
        {
            error = "Удалить проект может только председатель";
            return;
        }

        error = null;

        await projectService.DeleteProject(ProjectId);
        navigationManager.NavigateTo("/projects");
    }

    private class DeleteViewModel
    {
    }
}
