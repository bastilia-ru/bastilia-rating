@switch (Status)
{
    case BastiliaFinalStatus.Active:
        <JoinBadge Variation="VariationStyleEnum.Success">
            Бастилец
        </JoinBadge>
        break;
    case BastiliaFinalStatus.Retired:
        <JoinBadge Variation="VariationStyleEnum.None" Title="Бывший бастилец">
            Досрочно-освобожденный
        </JoinBadge>
        break;
    case BastiliaFinalStatus.Mate:
        <JoinBadge Variation="VariationStyleEnum.Info" Title="Есть хотя бы 1 активное достижение">
            Прибастиленный
        </JoinBadge>
        break;
    default:
        break;
}

@code {
    [Parameter]
    public BastiliaFinalStatus? Status { get; set; }
}
