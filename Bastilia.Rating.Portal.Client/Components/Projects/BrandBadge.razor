@switch (Type)
{
    case BrandType.Bastilia:
        <JoinBadge Variation="VariationStyleEnum.Success">
            Бастилия и друзья
        </JoinBadge>
        break;
    case BrandType.PubliclySupported:
        <JoinBadge Variation="VariationStyleEnum.Success">
            Поддерживаем проект
        </JoinBadge>
        break;
    case BrandType.PrivatelySupported:
    case BrandType.JustTracked:
        break;
    default:
        <JoinBadge Variation="VariationStyleEnum.None">
            Не определен
        </JoinBadge>
        break;
}

@code {
    [Parameter]
    public BrandType? Type { get; set; }
}
