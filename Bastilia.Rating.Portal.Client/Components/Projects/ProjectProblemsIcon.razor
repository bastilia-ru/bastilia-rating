@using Bastilia.Rating.Domain
@if (Project.HasProblems)
{
    <span class="text-warning">
        <JoinIcon Icon="JoinIconType.Warning" Title="@TooltipText" />
    </span>
}
@code {
    [Parameter, EditorRequired]
    public BastiliaProject Project { get; set; } = null!;

    private string TooltipText => string.Join("; ", Project.Problems.DescribeProblems());
}
